generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  COORDINATOR
  LEADER
  ADMIN_SYSTEM
  INSTRUKTUR
  ASISTEN_DOSEN
  KAPRODI
}

enum SubRole {
  DOSEN
  MAHASISWA
  INSTRUKTUR
  ASISTEN_DOSEN
}

enum ProdiStatus {
  AKTIF
  NONAKTIF
}

enum PeriodeStatus {
  AKTIF
  NONAKTIF
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum LabStatus {
  AKTIF
  NONAKTIF
}

enum ScheduleType {
  PRAKTIKUM_RUTIN
  KEGIATAN_KHUSUS
}

enum MataKuliahStatus {
  AKTIF
  NONAKTIF
}

enum ScheduleStatus {
  AKTIF
  DIBATALKAN
}

enum BookingStatus {
  DIAJUKAN
  DISETUJUI
  DITOLAK
  DIBATALKAN
  SELESAI
}

enum IssueCategory {
  PERANGKAT
  JARINGAN
  LISTRIK
  PERANGKAT_LUNAK
  FASILITAS
  LAINNYA
}

enum IssueUrgency {
  RENDAH
  SEDANG
  TINGGI
}

enum IssueStatus {
  BARU
  DIVERIFIKASI
  DALAM_PENANGANAN
  SELESAI
  DITOLAK
}

enum AttendanceStatus {
  HADIR
  TERLAMBAT
  IZIN
  SAKIT
  TIDAK_HADIR
}

enum InventoryCondition {
  BAIK
  PERLU_PERAWATAN
  RUSAK
  DIHAPUSKAN
}

enum InventoryCategory {
  PC
  JARINGAN
  PERIFERAL
  PERANGKAT_PENDUKUNG
}

enum RecruitmentStatus {
  DIBUKA
  DITUTUP
}

enum ApplicationStatus {
  DIAJUKAN
  DIPROSES
  WAWANCARA
  DITERIMA
  DITOLAK
  CADANGAN
}

enum ApplicantType {
  INSTRUKTUR
  ASISTEN_DOSEN
}

model User {
  id           String     @id @default(cuid())
  nama         String
  email        String     @unique
  passwordHash String
  role         Role       @default(USER)
  subRoles     SubRole[]
  status       UserStatus @default(ACTIVE)
  deletedAt    DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  schedulesAsPengampu Schedule[] @relation("Pengampu")
  mataKuliahDosen      MataKuliah[] @relation("MataKuliahDosen")
  mataKuliahInstruktur MataKuliah[] @relation("MataKuliahInstruktur")
  bookings            Booking[]  @relation("Peminjam")
  processedBookings   Booking[]  @relation("Pemroses")
  issues              Issue[]    @relation("Pelapor")
  assignedIssues      Issue[]    @relation("PenanggungJawab")
  attendances         Attendance[]
  applications        Application[]
  notifications       Notification[]
  auditLogs           AuditLog[]
  enrollments         ClassEnrollment[]
  prodi               Prodi?    @relation("ProdiUsers", fields: [prodiId], references: [id])
  prodiId             String?
  kaprociProdi        Prodi?    @relation("ProdiKaproci")
  periode             Periode?  @relation(fields: [periodeId], references: [id])
  periodeId           String?
}

model Prodi {
  id          String   @id @default(cuid())
  kode        String   @unique
  nama        String
  status      ProdiStatus @default(AKTIF)
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  kaprodiId   String?   @unique
  kaproci     User?    @relation("ProdiKaproci", fields: [kaprodiId], references: [id])
  
  users       User[]   @relation("ProdiUsers")
  mataKuliah  MataKuliah[]
  schedules   Schedule[]
  attendance  Attendance[]
  recruitmentPeriods RecruitmentPeriod[]

  @@index([kode])
}

model Periode {
  id          String   @id @default(cuid())
  nama        String   // contoh: "2026/2027 Ganjil", "2026/2027 Genap"
  kode        String   @unique // contoh: "202627-GANJIL", "202627-GENAP"
  tanggalMulai DateTime
  tanggalSelesai DateTime
  status      PeriodeStatus @default(AKTIF)
  isCurrent   Boolean  @default(false)
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  schedules   Schedule[]
  mataKuliah  MataKuliah[]
  attendance  Attendance[]
  bookings    Booking[]
  recruitmentPeriods RecruitmentPeriod[]
  users       User[]
  inventoryItems InventoryItem[]
  labs        Lab[]
  issues      Issue[]

  @@index([kode])
  @@index([isCurrent])
}

model Lab {
  id        String    @id @default(cuid())
  kode      String    @unique
  nama      String
  kapasitas Int
  lokasi    String
  status    LabStatus @default(AKTIF)
  qrToken   String    @unique
  qrVersion Int       @default(1)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  schedules  Schedule[]
  bookings   Booking[]
  issues     Issue[]
  attendances Attendance[]
  inventory  InventoryItem[]
  periode    Periode?           @relation(fields: [periodeId], references: [id])
  periodeId  String?
}

model Schedule {
  id            String         @id @default(cuid())
  labId         String
  mataKuliahId  String?
  mataKuliah    String
  kelas         String
  pengampuId    String?
  asistenIds    String[]  @default([])
  hari          Int
  jamMulai      String
  jamSelesai    String
  tanggalMulai  DateTime
  tanggalSelesai DateTime
  semester      String
  jenis         ScheduleType   @default(PRAKTIKUM_RUTIN)
  status        ScheduleStatus @default(AKTIF)
  deletedAt     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  lab       Lab   @relation(fields: [labId], references: [id])
  pengampu  User? @relation("Pengampu", fields: [pengampuId], references: [id])
  course    MataKuliah? @relation(fields: [mataKuliahId], references: [id])
  prodi     Prodi?   @relation(fields: [prodiId], references: [id])
  prodiId   String?
  periode   Periode? @relation(fields: [periodeId], references: [id])
  periodeId String?
  bookings  Booking[]
  attendances Attendance[]
  enrollments ClassEnrollment[]
  qrTokens    SessionQrToken[]

  @@index([labId, hari, jamMulai])
  @@index([mataKuliahId])
  @@index([prodiId])
  @@index([periodeId])
}

model MataKuliah {
  id           String           @id @default(cuid())
  kode         String           @unique
  nama         String
  sks          Int              @default(3)
  semester     Int              @default(1)
  dosenId      String?
  instrukturId String?
  asistenIds   String[]         @default([])
  deskripsi    String?
  status       MataKuliahStatus @default(AKTIF)
  deletedAt    DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  dosen      User?      @relation("MataKuliahDosen", fields: [dosenId], references: [id])
  instruktur User?      @relation("MataKuliahInstruktur", fields: [instrukturId], references: [id])
  schedules  Schedule[]
  prodi      Prodi?     @relation(fields: [prodiId], references: [id])
  prodiId    String?
  periode    Periode?   @relation(fields: [periodeId], references: [id])
  periodeId  String?

  @@index([status])
  @@index([nama])
  @@index([prodiId])
}

model Booking {
  id              String        @id @default(cuid())
  /// Kosong bila pengajuan dikirim publik (tanpa akun).
  peminjamId      String?
  /// Kode publik untuk memeriksa status pengajuan tanpa masuk.
  kodePengajuan   String?       @unique
  /// Data peminjam publik (tanpa akun).
  namaPeminjam    String?
  emailPeminjam   String?
  noWhatsapp      String?
  nim             String?
  labId           String
  scheduleId      String?
  tanggal         DateTime
  jamMulai        String
  jamSelesai      String
  keperluan       String
  jumlahPeserta   Int?
  kebutuhanKhusus String?
  lampiranUrl     String?
  status          BookingStatus @default(DIAJUKAN)
  pemrosesId      String?
  alasanKeputusan String?
  deletedAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  peminjam  User?     @relation("Peminjam", fields: [peminjamId], references: [id])
  lab       Lab       @relation(fields: [labId], references: [id])
  schedule  Schedule? @relation(fields: [scheduleId], references: [id])
  pemroses  User?     @relation("Pemroses", fields: [pemrosesId], references: [id])
  periode   Periode?  @relation(fields: [periodeId], references: [id])
  periodeId String?

  @@index([labId, tanggal, jamMulai])
  @@index([periodeId])
}

model Issue {
  id               String        @id @default(cuid())
  nomorTiket       String        @unique
  /// Kosong bila laporan dikirim publik (tanpa akun).
  pelaporId        String?
  /// Data pelapor publik (tanpa akun).
  namaPelapor      String?
  emailPelapor     String?
  noWhatsapp       String?
  nim              String?
  labId            String
  itemId           String?
  kategori         IssueCategory
  urgensi          IssueUrgency  @default(SEDANG)
  deskripsi        String
  fotoUrls         String[]
  status           IssueStatus   @default(BARU)
  dueAt            DateTime?
  resolvedAt       DateTime?
  penanggungJawabId String?
  deletedAt        DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  pelapor          User?          @relation("Pelapor", fields: [pelaporId], references: [id])
  lab              Lab            @relation(fields: [labId], references: [id])
  item             InventoryItem? @relation(fields: [itemId], references: [id])
  penanggungJawab  User?          @relation("PenanggungJawab", fields: [penanggungJawabId], references: [id])
  history          IssueHistory[]
  periode          Periode?       @relation(fields: [periodeId], references: [id])
  periodeId        String?
}

model IssueHistory {
  id        String      @id @default(cuid())
  issueId   String
  status    IssueStatus
  catatan   String?
  actorId   String
  createdAt DateTime    @default(now())

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
}

model Attendance {
  id               String           @id @default(cuid())
  sesiId           String
  userId           String
  labId            String
  /// Tanggal pertemuan (UTC tengah malam untuk tanggal kalender Jakarta)
  tanggal          DateTime         @default(now())
  scannedAt        DateTime         @default(now())
  /// Petugas yang memvalidasi (mis. KM kelas via scan QR)
  validatedBy      String?
  validatedAt      DateTime?
  validationSource String?
  /// Pertemuan ke-berapa (mis. 1, 2, 3...) pada mata kuliah ini
  pertemuanKe      Int?
  /// Materi ajar yang dibahas pada pertemuan ini (deskripsi atau tautan)
  materi           String?
  status           AttendanceStatus
  qrTokenScanned   String
  correctedBy      String?
  correctionReason String?
  oldValue         String?
  deletedAt        DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  sesi  Schedule @relation(fields: [sesiId], references: [id])
  user  User     @relation(fields: [userId], references: [id])
  lab   Lab      @relation(fields: [labId], references: [id])
  prodi   Prodi?    @relation(fields: [prodiId], references: [id])
  prodiId String?
  periode Periode? @relation(fields: [periodeId], references: [id])
  periodeId String?

  @@unique([sesiId, userId, tanggal, pertemuanKe])
  @@index([prodiId])
  @@index([periodeId])
}

model ClassEnrollment {
  id         String    @id @default(cuid())
  scheduleId String
  userId     String
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())

  schedule Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, userId])
  @@index([userId])
}

model SessionQrToken {
  id          String    @id @default(cuid())
  scheduleId  String
  token       String    @unique
  expiresAt   DateTime
  createdBy   String
  createdAt   DateTime  @default(now())
  /// Tanggal sesi absensi yang divalidasi (opsional; token lama tidak memilikinya).
  tanggal     DateTime?
  /// Pertemuan ke- yang divalidasi (opsional; token lama tidak memilikinya).
  pertemuanKe Int?

  schedule Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([scheduleId, expiresAt])
}

model InventoryItem {
  id             String             @id @default(cuid())
  kodeAset       String             @unique
  nama           String
  kategori       InventoryCategory
  labId          String
  kondisi        InventoryCondition @default(BAIK)
  tanggalPerolehan DateTime?
  catatan        String?
  deletedAt      DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  lab        Lab                @relation(fields: [labId], references: [id])
  issues     Issue[]
  mutations  InventoryMutation[]
  periode    Periode?           @relation(fields: [periodeId], references: [id])
  periodeId  String?
}

model InventoryMutation {
  id          String   @id @default(cuid())
  itemId      String
  labAsalId   String
  labTujuanId String
  tanggal     DateTime @default(now())
  actorId     String

  item InventoryItem @relation(fields: [itemId], references: [id])
}

model RecruitmentPeriod {
  id          String            @id @default(cuid())
  posisi      String
  tipe        ApplicantType     @default(ASISTEN_DOSEN)
  mataKuliah  String
  kuota       Int
  persyaratan String?
  tenggat     DateTime
  status      RecruitmentStatus @default(DIBUKA)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  prodi       Prodi?      @relation(fields: [prodiId], references: [id])
  prodiId     String?
  periode     Periode?    @relation(fields: [periodeId], references: [id])
  periodeId   String?

  applications Application[]
}

model Application {
  id                String            @id @default(cuid())
  periodId          String
  pelamarId         String?
  tipe              ApplicantType?
  namaLengkap       String?
  emailKontak       String?
  nim               String?
  gelar             String?
  noWhatsapp        String?
  mataKuliahDilamar String
  motivasi          String?
  nilai             Float?
  ketersediaan      String?
  suratLamaranUrl   String?
  cvUrl             String?
  transkripUrl      String?
  pernyataan        Boolean           @default(false)
  status            ApplicationStatus @default(DIAJUKAN)
  catatanPenilaian  String?
  deletedAt         DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  period  RecruitmentPeriod @relation(fields: [periodId], references: [id])
  pelamar User?             @relation(fields: [pelamarId], references: [id])
}

model Notification {
  id         String   @id @default(cuid())
  recipientId String
  jenis      String
  isi        String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  recipient User @relation(fields: [recipientId], references: [id])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  action    String
  objectType String
  objectId  String
  oldValue  Json?
  newValue  Json?
  createdAt DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id])
}
